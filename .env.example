# Required application infrastructure
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/smark_connect?schema=public"
AUTH_SECRET="generate-a-long-random-value"
SECRET_ENCRYPTION_KEY="base64-encoded-32-byte-key"
AUTH_URL="http://localhost:3000"

# Optional platform login provider
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional self-hosted Lighthouse resource controls
LIGHTHOUSE_RATE_LIMIT_PER_HOUR="5"
LIGHTHOUSE_MAX_QUEUE_DEPTH="5"
PUPPETEER_EXECUTABLE_PATH=""

# Optional Google-hosted PageSpeed Insights provider (selected automatically when a key is present)
PAGESPEED_INSIGHTS_API_KEY=""
SPEED_AUDIT_PROVIDER="auto"

# Optional integration credentials — the app boots without these
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
TELEGRAM_BOT_TOKEN=""
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

# Optional provider model overrides. LLM keys are always entered per-user in the app.
SMARK_MODEL_ANTHROPIC="claude-haiku-4-5"
SMARK_MODEL_OPENAI="gpt-5.4-mini"
SMARK_MODEL_OPENROUTER="openai/gpt-5.4-mini"
SMARK_MODEL_GOOGLE="gemini-3.6-flash"
